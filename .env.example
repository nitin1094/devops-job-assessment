# Copy to .env if you want to change any of these. The defaults work as-is --
# docker compose and every script in scripts/ fall back to the same values.
POSTGRES_USER=bookings
POSTGRES_PASSWORD=bookings_local_pw
POSTGRES_DB=bookings
POSTGRES_PORT=55432
ADMINER_PORT=8080

# How many timestamped dumps scripts/backup.sh keeps before pruning the oldest.
BACKUP_RETENTION=7
